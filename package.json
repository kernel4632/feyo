{
  "name": "@kernel4632/feyo",
  "version": "0.4.0",
  "description": "FEYO (Flow, Ease, Yield, Orientation) - a high-focus Web UI design system and component library.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/feyo.js",
  "module": "./dist/feyo.js",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": "./dist/feyo.js",
      "default": "./dist/feyo.js"
    },
    "./elements": {
      "import": "./dist/feyo-elements.js",
      "default": "./dist/feyo-elements.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/feyo-elements.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "node scripts/build-lib.js",
    "verify:lib": "node scripts/verify-package.js",
    "prepack": "pnpm build:lib",
    "preview": "vite preview --outDir site-dist",
    "test": "playwright test",
    "test:ssr": "node --test tests/notification.ssr.test.js"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/vue": "^1.0.8"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.105.1",
    "vite": "^8.3.0",
    "vue": "^3.5.42"
  }
}
